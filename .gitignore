# Terraform working dirs and plans
**/.terraform/*
*.tfplan
*.tfplan.json
crash.log
crash.*.log

# State — must never be committed (contains secrets in plaintext)
*.tfstate
*.tfstate.*

# Variable files that may hold secrets / account-specific values.
# task1-ec2/terraform.tfvars is intentionally committed (no secrets).
task3-iam/terraform.tfvars
*.auto.tfvars
backend.hcl

# Local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc
terraform.rc

# OS / editor
.DS_Store
.idea/
.vscode/

# NOTE: .terraform.lock.hcl is deliberately NOT ignored — commit it so every
# machine and CI run uses the same provider build.
